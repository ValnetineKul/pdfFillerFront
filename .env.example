# Dev server only. The browser still calls /api on this site; Vite forwards it here.
# Railway's public URL is HTTPS on port 443. 8080 is the port inside the container.
API_PROXY_TARGET=https://pdffillerapi-production.up.railway.app

# Leave empty for local dev and for Vercel. vercel.json proxies /api to Railway,
# which keeps the login cookie on the site origin.
# Set a full origin only if the browser should call the API directly.
VITE_API_URL=
