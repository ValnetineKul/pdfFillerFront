{
  "name": "pdffiller",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm generate-api-schemas && pnpm panda:prepare && vite",
    "build": "pnpm generate-api-schemas && pnpm panda:prepare && vite build",
    "preview": "vite preview",
    "generate-api-schemas": "openapi-typescript --root-types",
    "panda:prepare": "panda codegen --clean && panda cssgen --outfile styled-system/styles.css",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.1.0",
    "@front/icons": "file:./packages/icons",
    "@hookform/resolvers": "5.2.2",
    "@internationalized/date": "3.12.2",
    "@pdf-lib/fontkit": "^1.1.1",
    "@react-aria/utils": "3.34.1",
    "@react-types/shared": "3.36.0",
    "@tanstack/react-table": "8.20.5",
    "@tanstack/react-virtual": "3.14.6",
    "input-otp": "1.4.2",
    "mammoth": "^1.13.0",
    "openapi-fetch": "0.15.0",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "4.10.38",
    "react": "19.2.7",
    "react-aria": "3.50.0",
    "react-aria-components": "1.19.0",
    "react-dom": "19.2.7",
    "react-hook-form": "7.65.0",
    "react-router": "7.9.4",
    "react-select5": "npm:react-select@5.10.2",
    "react-stately": "3.48.0",
    "tesseract.js": "5.1.1",
    "zod": "4.0.5"
  },
  "devDependencies": {
    "@pandacss/dev": "0.51.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.4",
    "openapi-typescript": "7.10.1",
    "typescript": "5.9.3",
    "vite": "8.1.5",
    "vitest": "^5.0.2"
  }
}
