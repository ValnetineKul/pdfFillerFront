{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "#temp/*": ["./.temp/*"],
      "#styled-system/*": ["./styled-system/*"],
      "#shared/utils": ["./src/types/shared-utils.ts"],
      "#shared/*": ["./design-system/src/shared/*"]
    }
  },
  "include": ["src", "vite.config.ts", ".temp/api-schemas"]
}
